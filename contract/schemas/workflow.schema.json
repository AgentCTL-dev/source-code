  "$id": "https://agentd.dev/schema/workflow-3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "armed": {
      "default": true,
      "type": "boolean"
    },
    "concurrency": {
      "properties": {
        "max_runs": {
          "minimum": 1,
          "type": "integer"
        },
        "on_overflow": {
          "enum": [
            "queue",
            "drop",
            "replace"
          ]
        },
        "scope": {
          "description": "what max_runs counts: every run of this workflow (default), or every run about the same `key` — the difference between a queue and a per-entity lock",
          "enum": [
            "workflow",
            "key"
          ]
        }
      },
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "durable": {
      "description": "false = runs are memory-only (no checkpoints, gone after a restart) — the fast path for recomputable work; absent = the store.durability.work default (durable)",
      "type": "boolean"
    },
    "file": {
      "description": "load the document from a path on disk instead of inline",
      "type": "string"
    },
    "inputs": {
      "properties": {
        "schema": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "key": {
      "description": "the logical thing a run is ABOUT, rendered from the trigger payload (e.g. \"{{payload.account_id}}\"); required by concurrency.scope: key",
      "type": "string"
    },
    "limits": {
      "properties": {
        "budget": {
          "type": "object"
        },
        "deadline": {
          "type": "string"
        },
        "steps": {
          "type": "integer"
        },
        "tokens": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": {
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,63}$",
      "type": "string"
    },
    "outputs": {
      "properties": {
        "schema": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "priority": {
      "description": "contention weight: `low` sheds one pressure level earlier and is scheduled last; a tiebreak under scarcity, not a reservation",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "state": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "reducer": {
            "description": "how concurrent writes to this key combine; declaring it makes concurrency a policy rather than a race",
            "enum": [
              "overwrite",
              "append",
              "merge",
              "union"
            ]
          },
          "schema": {
            "description": "a JSON Schema every write to this key must satisfy",
            "type": "object"
          }
        },
        "type": "object"
      },
      "description": "declared run variables — {key: {schema, reducer}}",
      "type": "object"
    },
    "steps": {
      "additionalProperties": {
        "$ref": "#/$defs/step"
      },
      "minProperties": 1,
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "description": "register this workflow as a first-class tool — a callable procedure with retry, breaker, idempotency and a human gate INSIDE one apparent call. Startup config only; tags are DERIVED from what the steps reach.",
      "properties": {
        "grant": {
          "additionalProperties": false,
          "properties": {
            "agent": {
              "type": "boolean"
            },
            "root": {
              "type": "boolean"
            },
            "subagents": {
              "type": "boolean"
            },
            "user": {
              "type": "boolean"
            },
            "workflows": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "mode": {
