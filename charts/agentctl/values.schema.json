{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agentctl Helm values",
  "description": "Validates the top-level shape of agentctl chart values. Intentionally permissive (additionalProperties allowed on most objects) so valid installs are never rejected, while still catching type mistakes (e.g. a string where an integer/boolean is required).",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "logLevel": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "envFrom": {
          "type": "array"
        },
        "allowedRegistries": {
          "type": "string"
        },
        "secretsNamespaces": {
          "type": "array"
        },
        "attestIdentity": {
          "type": "boolean"
        },
        "inferProxy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "socketDir": {
              "type": "string"
            }
          }
        },
        "store": {
          "type": "string",
          "enum": [
            "memory",
            "postgres"
          ]
        },
        "mtls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowedNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scalerCommonName": {
              "type": "string"
            }
          }
        },
        "federationPeers": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "coordinationUrl": {
          "type": "string"
        },
        "scaler": {
          "type": "object"
        },
        "probes": {
          "type": "object"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "annotations": {
              "type": "object"
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "registry": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array"
        },
        "digests": {
          "type": "object"
        }
      }
    },
    "referenceAgent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "string"
        }
      }
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dashboards": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "podSecurity": {
          "type": "string"
        }
      }
    },
    "certManager": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "caIssuerRef": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "bundled",
            "external"
          ]
        },
        "bundled": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "string"
            },
            "runAsUser": {
              "type": "integer"
            },
            "storage": {
              "type": "string"
            },
            "pvcSize": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "verifyFull": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dsnSecretName": {
              "type": "string"
            },
            "dsnSecretKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "operator": {
      "$ref": "#/definitions/component"
    },
    "apiserver": {
      "$ref": "#/definitions/component"
    },
    "gateway": {
      "$ref": "#/definitions/component"
    },
    "admission": {
      "$ref": "#/definitions/component"
    },
    "coordination": {
      "$ref": "#/definitions/component"
    },
    "scaler": {
      "$ref": "#/definitions/component"
    },
    "apiToken": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "trustedProxy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowedNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proxyCommonName": {
          "type": "string"
        },
        "headerPrefix": {
          "type": "string"
        },
        "identityHeaders": {
          "type": "object",
          "properties": {
            "user": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "groups": {
              "type": "string"
            }
          }
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "agentNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "description": "Identity plane: identity.aauth (portable AGENT identity wiring for the operator) and identity.service (the agentctl-identity SERVICE: federated OIDC, device-flow login, principal minting, the AAuth provider role).",
      "properties": {
        "aauth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {
              "type": "string",
              "description": "Agent Provider issuer URL; empty = off."
            },
            "adminTokenSecret": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": true,
          "description": "The agentctl-identity service (RFC 0028).",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "store": {
              "type": "string",
              "enum": [
                "memory",
                "postgres"
              ]
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "issuer",
                  "client_id"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "issuer": {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  "client_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "issuerCa": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "configMapName": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "sealKeySecret": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "aauth": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "tokenTtl": {
                  "type": "integer",
                  "minimum": 60
                },
                "seedSecret": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "description": "Managed state service (P3): the mcpg-backed checkpointer for store.class: managed agents.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "description": "Blessed mcpg image, digest-pinned."
        },
        "pluginImage": {
          "type": "string",
          "description": "backend-sql plugin OCI reference."
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "control": {
      "type": "object",
      "description": "Control MCP (P4-1): AAuth-verified, namespace-scoped control.* tools for supervisors.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
